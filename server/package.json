{
  "name": "fashion-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx src/scripts/seed.ts",
    "admin:promote": "tsx src/scripts/promote-admin.ts",
    "db:check": "tsx src/scripts/check-mongodb.ts",
    "test:mongodb": "tsx --test tests/mongodb.test.ts",
    "clerk:check": "tsx src/scripts/check-clerk-sync.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.84",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "resend": "^6.34.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
