# Foundation
MONGODB_URL=mongodb://127.0.0.1:27017/fashion_development?replicaSet=rs0
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional until the related endpoints are configured. Placeholders only.
# The browser publishable key belongs in client/.env.local as VITE_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=replace_with_clerk_server_key
CLERK_WEBHOOK_SIGNING_SECRET=replace_with_clerk_signing_secret
STRIPE_SECRET_KEY=replace_with_stripe_server_key
# Stripe webhook activation stays pending. No secret is required for foundation work.
# STRIPE_WEBHOOK_SECRET=configure_only_before_enabling_verified_stripe_webhooks
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=FASHION <orders@your-verified-domain.example>
EMAIL_ENABLED=false

# Business decisions must be explicitly approved before enabling real checkout.
CHECKOUT_ENABLED=false
# CURRENCY=usd
# SHIPPING_MINOR=replace_with_approved_nonnegative_integer
# TAX_BASIS_POINTS=replace_with_approved_integer_0_to_10000

# Optional approved DNS resolver IPs; blank uses system DNS.
MONGODB_DNS_SERVERS=
